<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Courtside — Team Stat Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --bg:#10161A;
    --panel:#1A2226;
    --panel-hi:#212B30;
    --panel-hi2:#28333A;
    --ink:#EDEAE2;
    --ink-dim:#8B98A0;
    --ink-faint:#5B676D;
    --accent:#FF7A33;
    --accent-ink:#2A1204;
    --make:#33C17B;
    --miss:#E5484D;
    --line:#2A3438;
    --wood:#C9A876;
    --radius:16px;
    --radius-sm:10px;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    overscroll-behavior-y:none;
    user-select:none;
  }
  .num{font-family:'Space Grotesk',sans-serif; font-variant-numeric:tabular-nums;}
  #app{
    max-width:520px;
    margin:0 auto;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    position:relative;
  }
  #content{
    flex:1;
    overflow-y:auto;
    padding:14px 14px calc(90px + var(--safe-bottom));
    -webkit-overflow-scrolling:touch;
  }
  /* ---------- Bottom nav ---------- */
  #bottomNav{
    position:fixed;
    bottom:0; left:50%; transform:translateX(-50%);
    width:100%; max-width:520px;
    display:flex;
    background:var(--panel);
    border-top:1px solid var(--line);
    padding-bottom:var(--safe-bottom);
    z-index:50;
  }
  #bottomNav button{
    flex:1;
    background:none; border:none;
    color:var(--ink-dim);
    font-family:'Inter',sans-serif;
    font-size:12.5px;
    font-weight:600;
    padding:12px 4px 10px;
    display:flex; flex-direction:column; align-items:center; gap:4px;
    cursor:pointer;
  }
  #bottomNav button .dot{width:6px;height:6px;border-radius:50%;background:transparent;}
  #bottomNav button.active{color:var(--ink);}
  #bottomNav button.active .dot{background:var(--accent);}

  /* ---------- Generic bits ---------- */
  h1,h2,h3{font-family:'Space Grotesk',sans-serif; margin:0 0 4px;}
  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:16px;
    margin-bottom:14px;
  }
  .muted{color:var(--ink-dim); font-size:13.5px; line-height:1.5;}
  .btn{
    display:inline-flex; align-items:center; justify-content:center;
    background:var(--panel-hi2);
    color:var(--ink);
    border:1px solid var(--line);
    border-radius:var(--radius-sm);
    padding:13px 18px;
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:15px;
    cursor:pointer;
    min-height:48px;
  }
  .btn.primary{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
  .btn.block{width:100%;}
  .btn.danger-outline{background:transparent; border-color:var(--miss); color:var(--miss);}
  .btn:active{filter:brightness(0.88); transform:scale(0.98);}
  input[type=text], input[type=number]{
    width:100%;
    background:var(--panel-hi);
    border:1px solid var(--line);
    border-radius:var(--radius-sm);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    font-size:16px;
    padding:12px 14px;
    margin-top:6px;
  }
  label.field{display:block; font-size:13px; color:var(--ink-dim); font-weight:600; margin-top:10px;}
  .row{display:flex; gap:10px;}
  .row > *{flex:1;}
  .toast{
    position:fixed; left:50%; top:16px; transform:translateX(-50%);
    background:var(--panel-hi2); border:1px solid var(--line);
    padding:10px 16px; border-radius:999px; font-size:13.5px;
    z-index:200; opacity:0; pointer-events:none; transition:opacity .25s ease, top .25s ease;
  }
  .toast.show{opacity:1; top:26px;}

  /* ---------- Scoreboard ---------- */
  .scoreboard{
    display:flex; align-items:center; justify-content:space-between;
    background:var(--panel); border:1px solid var(--line);
    border-radius:var(--radius); padding:14px 16px; margin-bottom:12px;
  }
  .sb-team{flex:1; text-align:center;}
  .sb-name{font-size:12.5px; color:var(--ink-dim); font-weight:600; letter-spacing:.2px; margin-bottom:2px;}
  .sb-score{font-size:34px; font-weight:700; line-height:1;}
  .sb-mid{padding:0 14px; text-align:center;}
  .sb-vs{color:var(--ink-faint); font-size:11px; font-weight:600;}
  .opp-add{display:flex; gap:6px; justify-content:center; margin-top:8px;}
  .opp-add button{
    background:var(--panel-hi2); border:1px solid var(--line); color:var(--ink);
    border-radius:8px; padding:6px 0; width:34px; font-weight:700; font-size:13px; cursor:pointer;
  }

  .quarters{display:flex; gap:6px; margin-bottom:14px;}
  .quarters button{
    flex:1; padding:8px 0; border-radius:999px; border:1px solid var(--line);
    background:var(--panel); color:var(--ink-dim); font-weight:700; font-size:13px; cursor:pointer;
  }
  .quarters button.active{background:var(--wood); color:#221808; border-color:var(--wood);}

  .subtoggle{display:flex; gap:6px; margin-bottom:14px;}
  .subtoggle button{
    flex:1; padding:10px 0; border-radius:999px; border:1px solid var(--line);
    background:var(--panel); color:var(--ink-dim); font-weight:700; font-size:13px; cursor:pointer;
  }
  .subtoggle button.active{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
  /* Box-score modal's 5-tab strip: too many to stretch evenly on a phone, so
     it scrolls horizontally instead of wrapping into a ragged second row. */
  .subtoggle.boxtabs{overflow-x:auto; flex-wrap:nowrap; -webkit-overflow-scrolling:touch; padding-bottom:2px;}
  .subtoggle.boxtabs button{flex:0 0 auto; padding:8px 14px; font-size:12px; white-space:nowrap;}

  /* ---------- Player rail ---------- */
  .rail{display:grid; grid-template-columns:repeat(4, 1fr); gap:10px 6px; padding:2px 2px 10px; margin-bottom:8px;}
  .chip{
    text-align:center; cursor:pointer; min-width:0;
  }
  .chip .circle{
    width:52px; height:52px; border-radius:50%;
    background:var(--panel-hi); border:2px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:700;
    margin:0 auto 5px;
  }
  .chip.selected .circle{border-color:var(--accent); background:var(--panel-hi2); box-shadow:0 0 0 3px rgba(255,122,51,.18);}
  .chip .name{font-size:11px; color:var(--ink-dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .chip.selected .name{color:var(--ink); font-weight:600;}

  /* Drag-to-reorder (Live tab rail, reorder mode) */
  .rail.reordering .chip{cursor:grab; touch-action:none;}
  .rail.reordering .chip .circle{border-style:dashed;}
  .rail.reordering .chip.pinned{cursor:default;}
  .rail.reordering .chip.pinned .circle{border-style:solid; opacity:.55;}
  .chip.dragging{position:relative; z-index:20; cursor:grabbing;}
  .chip.dragging .circle{border-color:var(--accent); box-shadow:0 6px 18px rgba(0,0,0,.4);}
  .chip.drop-target .circle{border-color:var(--make); background:var(--panel-hi2); box-shadow:0 0 0 3px rgba(51,193,123,.25);}

  .selected-line{
    background:var(--panel-hi); border:1px solid var(--line); border-radius:var(--radius-sm);
    padding:10px 14px; margin-bottom:14px; font-size:13.5px; color:var(--ink-dim);
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;
  }
  .selected-line b{color:var(--ink); font-family:'Space Grotesk',sans-serif;}

  /* ---------- Stat pad ---------- */
  .statpad{display:grid; grid-template-columns:repeat(3,1fr); gap:9px; margin-bottom:14px;}
  .stat-btn{
    border-radius:var(--radius-sm);
    border:1px solid var(--line);
    background:var(--panel-hi);
    color:var(--ink);
    min-height:64px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:2px;
    cursor:pointer;
    font-family:'Inter',sans-serif;
  }
  .stat-btn .lbl{font-size:12.5px; font-weight:600;}
  .stat-btn .sub{font-size:10.5px; color:var(--ink-faint); font-weight:600;}
  .stat-btn.make{border-color:rgba(51,193,123,.4);}
  .stat-btn.make .lbl{color:var(--make);}
  .stat-btn.miss{border-color:rgba(229,72,77,.35);}
  .stat-btn.miss .lbl{color:var(--miss);}
  .stat-btn.flash{background:var(--panel-hi2); transform:scale(0.96);}
  .stat-btn:disabled{opacity:.35; cursor:not-allowed;}
  .stat-btn.lineup-sel{border-color:var(--accent); background:rgba(255,122,51,.14);}
  .stat-btn.lineup-sel .lbl{color:var(--accent);}

  .action-bar{display:flex; gap:10px; margin-bottom:6px;}
  .action-bar .btn{flex:1;}

  /* ---------- Box score table ---------- */
  table.boxscore{width:100%; border-collapse:collapse; font-size:12.5px;}
  table.boxscore th, table.boxscore td{
    padding:8px 6px; text-align:center; border-bottom:1px solid var(--line); white-space:nowrap;
  }
  table.boxscore th{color:var(--ink-dim); font-weight:600; font-size:11px;}
  table.boxscore td.name-cell{text-align:left; font-weight:600;}
  table.boxscore tfoot td{font-weight:700; border-top:2px solid var(--line); border-bottom:none;}
  .table-scroll{overflow-x:auto;}

  /* ---------- Assist heatmap ---------- */
  table.heatmap{border-collapse:separate; border-spacing:2px; font-size:12px;}
  table.heatmap th{color:var(--ink-dim); font-weight:600; font-size:10.5px; text-align:center; padding:4px 6px; white-space:nowrap;}
  table.heatmap td.heat-rowlabel{color:var(--ink-dim); font-weight:600; font-size:10.5px; text-align:right; padding:4px 8px 4px 4px; white-space:nowrap;}
  table.heatmap td.heat-cell{
    width:34px; height:30px; min-width:34px; text-align:center; font-weight:700;
    border-radius:5px; font-variant-numeric:tabular-nums;
  }
  .heat-axis-label{
    color:var(--ink-dim); font-weight:700; font-size:10.5px;
    text-transform:uppercase; letter-spacing:.05em;
    display:flex; align-items:center; justify-content:center; white-space:nowrap;
  }

  /* ---------- Roster list ---------- */
  .player-row{
    display:flex; align-items:center; gap:10px;
    background:var(--panel-hi); border:1px solid var(--line); border-radius:var(--radius-sm);
    padding:10px 12px; margin-bottom:8px;
  }
  .player-row .circle{
    width:38px;height:38px;border-radius:50%; background:var(--panel-hi2);
    display:flex; align-items:center; justify-content:center; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:14px;
    flex:0 0 auto;
  }
  .player-row .pname{flex:1; min-width:0; font-weight:600; font-size:14.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .player-row .row-actions{display:flex; align-items:center; gap:4px; flex:0 0 auto;}
  .player-row .rm{background:none; border:none; color:var(--ink-faint); font-size:20px; cursor:pointer; padding:4px 6px;}

  /* ---------- History ---------- */
  .game-row{
    background:var(--panel-hi); border:1px solid var(--line); border-radius:var(--radius-sm);
    padding:12px 14px; margin-bottom:8px; cursor:pointer;
  }
  .game-row .top-line{display:flex; justify-content:space-between; align-items:center;}
  .badge{font-size:11px; font-weight:700; padding:2px 8px; border-radius:999px;}
  .badge.win{background:rgba(51,193,123,.18); color:var(--make);}
  .badge.loss{background:rgba(229,72,77,.18); color:var(--miss);}
  .game-row .date{font-size:11.5px; color:var(--ink-faint); margin-top:3px;}

  /* ---------- Modal ---------- */
  .modal-back{
    position:fixed; inset:0; background:rgba(8,11,13,.72);
    display:flex; align-items:flex-end; justify-content:center; z-index:150;
  }
  .modal{
    width:100%; max-width:520px; background:var(--panel);
    border:1px solid var(--line); border-radius:20px 20px 0 0;
    padding:20px 18px calc(20px + var(--safe-bottom));
  }
  .modal .row{margin-top:14px;}

  .empty{text-align:center; padding:40px 10px; color:var(--ink-dim);}
  .empty .big{font-size:38px; margin-bottom:8px;}

  @media (min-width:600px){
    .statpad{grid-template-columns:repeat(4,1fr);}
    .sb-score{font-size:40px;}
    .rail{grid-template-columns:repeat(6, 1fr);}
  }
</style>
</head>
<body>
<div id="app">
  <div id="content"></div>
  <nav id="bottomNav">
    <button data-tab="live"><span class="dot"></span>Live Game</button>
    <button data-tab="roster"><span class="dot"></span>Roster</button>
    <button data-tab="history"><span class="dot"></span>History</button>
  </nav>
</div>
<div class="toast" id="toast"></div>
<div id="modalRoot"></div>

<script>
/* =========================================================
   STATE
========================================================= */
let roster = { teamName: 'My Team', players: [] };
let activeGame = null;      // {id, opponent, date, quarter, oppScore, selectedPlayerId, playerStats:{id:{...}}, log:[...]}
let history = [];           // array of finished game objects (same shape as activeGame + result)
let currentTab = 'live';
let boxScoreTab = 'boxscore'; // 'boxscore' | 'scoring' | 'assists' | 'shotchart' | 'possession' | 'lineups' — shared by the live & history box score modals
let lineupSelection = []; // pids currently toggled on in the Lineups tab; reset whenever a box score modal opens
let liveSubTab = 'us';
let liveReorderMode = false;
let loaded = false;

const STAT_ACTIONS = [
  { key:'fg2m', label:'2PT Make', sub:'+2 pts', cls:'make', inc:{fgm:1,fga:1,pts:2} },
  { key:'fg2a', label:'2PT Miss', sub:'', cls:'miss', inc:{fga:1} },
  { key:'fg3m', label:'3PT Make', sub:'+3 pts', cls:'make', inc:{fgm:1,fga:1,tpm:1,tpa:1,pts:3} },
  { key:'fg3a', label:'3PT Miss', sub:'', cls:'miss', inc:{fga:1,tpa:1} },
  { key:'ftm',  label:'FT Make',  sub:'+1 pt', cls:'make', inc:{ftm:1,fta:1,pts:1} },
  { key:'fta',  label:'FT Miss',  sub:'', cls:'miss', inc:{fta:1} },
  { key:'oreb', label:'Off. Rebound', sub:'', cls:'', inc:{reb:1,oreb:1} },
  { key:'dreb', label:'Def. Rebound', sub:'', cls:'', inc:{reb:1,dreb:1} },
  { key:'ast',  label:'Assist',   sub:'', cls:'', inc:{ast:1} },
  { key:'stl',  label:'Steal',    sub:'', cls:'', inc:{stl:1} },
  { key:'blk',  label:'Block',    sub:'', cls:'', inc:{blk:1} },
  { key:'tov',  label:'Turnover', sub:'', cls:'miss', inc:{tov:1} },
  { key:'pf',   label:'Foul',     sub:'', cls:'miss', inc:{pf:1} },
];

const BLANK_LINE = () => ({pts:0,reb:0,oreb:0,dreb:0,ast:0,stl:0,blk:0,tov:0,pf:0,fgm:0,fga:0,tpm:0,tpa:0,ftm:0,fta:0});

// A pinned pseudo-player for stats that couldn't be attributed to a specific
// player (a rebound or assist the coach missed who did). It lives in
// playerStats like a real player but isn't part of roster.players, so it's
// never draggable/reorderable and always shown first. Only the stat types
// that make sense without a named player are offered when it's selected.
const TEAM_PID = 'team';
const TEAM_NAME = 'Team';
const TEAM_NUMBER = 'TM';
const TEAM_ALLOWED_KEYS = ['oreb','dreb','ast','tov'];

// Made-shot keys that prompt "who got the assist?" right after they're logged.
const ASSIST_TRIGGER_KEYS = ['fg2m','fg3m'];
// Missed-shot keys that prompt "who got the rebound?" right after they're logged.
const MISS_TRIGGER_KEYS = ['fg2a','fg3a','fta'];
// Of those, only field-goal misses also get the "where was the shot?" zone
// prompt first — a free throw miss has no meaningful court location.
const LOCATION_MISS_KEYS = ['fg2a','fg3a'];
// Same idea for the Opponent tab — a missed field goal by them also opens the
// rebound prompt (swapped: their miss means a defensive board for US, an
// offensive board for THEM). Free throws are excluded there since the
// Opponent tab only tallies FT attempts as a single counter, with no
// make/miss split to hang a rebound decision off of.
const OPP_MISS_TRIGGER_KEYS = ['fg2a','fg3a'];

// Opponent is tracked as team-level counters only — no per-player detail needed.
const OPP_STAT_ACTIONS = [
  { key:'fg2m', label:'2PT Make', sub:'+2 pts', cls:'make', pts:2 },
  { key:'fg2a', label:'2PT Miss', sub:'', cls:'miss', pts:0 },
  { key:'fg3m', label:'3PT Make', sub:'+3 pts', cls:'make', pts:3 },
  { key:'fg3a', label:'3PT Miss', sub:'', cls:'miss', pts:0 },
  { key:'oreb', label:'Off. Rebound', sub:'', cls:'', pts:0 },
  { key:'dreb', label:'Def. Rebound', sub:'', cls:'', pts:0 },
  { key:'tov',  label:'Turnover', sub:'', cls:'miss', pts:0 },
  { key:'fta',  label:'FT Attempt', sub:'', cls:'', pts:0 },
  { key:'pf',   label:'Foul', sub:'', cls:'miss', pts:0 },
];
const BLANK_OPP = () => ({fg2m:0,fg2a:0,fg3m:0,fg3a:0,oreb:0,dreb:0,tov:0,fta:0,pf:0});
function ensureOppStats(g){ g.oppStats = Object.assign(BLANK_OPP(), g.oppStats||{}); }
const BLANK_FB = () => ({us:0, opp:0, usMiss:0, oppMiss:0});
function ensureFastBreak(g){ g.fastBreak = Object.assign(BLANK_FB(), g.fastBreak||{}); }
// Transient (not persisted): whether the "next shot is a fast break" toggle is armed, per side.
let fbArmed = { us:false, opp:false };
// Shot-attempt keys eligible to consume the fast break toggle on a miss (mirrors the make keys that already carry inc.pts / pts).
const FASTBREAK_MISS_KEYS_US = ['fg2a','fg3a','fta'];
const FASTBREAK_MISS_KEYS_OPP = ['fg2a','fg3a'];

function uid(prefix){ return prefix + '_' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

// Swaps a roster player with their neighbor one slot up/down (dir = -1 or 1).
// Order is stored on roster.players itself, so it's shared everywhere the
// roster is shown (Live tab grid, Roster tab list) and persists across games.
function movePlayerInRoster(id, dir){
  const idx = roster.players.findIndex(p=>p.id===id);
  if(idx<0) return;
  const swapIdx = idx + dir;
  if(swapIdx<0 || swapIdx>=roster.players.length) return;
  const tmp = roster.players[idx];
  roster.players[idx] = roster.players[swapIdx];
  roster.players[swapIdx] = tmp;
  saveRoster();
}

// Swaps two roster players by id, wherever they currently sit — used by the
// Live tab's drag-to-reorder grid, where a player can be dropped onto any
// other chip, not just an adjacent one.
function swapPlayersInRoster(idA, idB){
  const ia = roster.players.findIndex(p=>p.id===idA);
  const ib = roster.players.findIndex(p=>p.id===idB);
  if(ia<0 || ib<0 || ia===ib) return;
  const tmp = roster.players[ia];
  roster.players[ia] = roster.players[ib];
  roster.players[ib] = tmp;
  saveRoster();
}

// Pointer-based drag-and-drop for the Live tab's player rail while in reorder
// mode. Uses Pointer Events (not HTML5 drag-and-drop) so the same code works
// with touch on a phone/tablet and a mouse — HTML5 DnD's touch support is
// unreliable on mobile browsers. A render() call would destroy the chip
// mid-drag, so nothing here calls render() until the drop itself.
function attachRailDragHandlers(rail){
  let drag = null; // {pid, chip, startX, startY, moved}
  rail.querySelectorAll('.chip[data-pid]').forEach(chip=>{
    if(chip.dataset.pid === TEAM_PID) return; // pinned — not draggable, not a drop target
    chip.addEventListener('pointerdown', e=>{
      drag = { pid: chip.dataset.pid, chip, startX: e.clientX, startY: e.clientY, moved:false };
      if(chip.setPointerCapture) chip.setPointerCapture(e.pointerId);
      chip.classList.add('dragging');
    });
    chip.addEventListener('pointermove', e=>{
      if(!drag || drag.chip!==chip) return;
      const dx = e.clientX - drag.startX, dy = e.clientY - drag.startY;
      if(Math.abs(dx)>4 || Math.abs(dy)>4) drag.moved = true;
      chip.style.transform = `translate(${dx}px, ${dy}px)`;
      chip.style.pointerEvents = 'none';
      const under = document.elementFromPoint(e.clientX, e.clientY);
      chip.style.pointerEvents = '';
      rail.querySelectorAll('.chip.drop-target').forEach(c=>c.classList.remove('drop-target'));
      const target = under && under.closest('.chip[data-pid]');
      if(target && target!==chip && target.dataset.pid!==TEAM_PID) target.classList.add('drop-target');
    });
    const endDrag = e=>{
      if(!drag || drag.chip!==chip) return;
      chip.style.transform = '';
      chip.classList.remove('dragging');
      const under = document.elementFromPoint(e.clientX, e.clientY);
      rail.querySelectorAll('.chip.drop-target').forEach(c=>c.classList.remove('drop-target'));
      const target = under && under.closest('.chip[data-pid]');
      if(drag.moved && target && target!==chip && target.dataset.pid!==TEAM_PID){
        swapPlayersInRoster(drag.pid, target.dataset.pid);
        render();
      }
      drag = null;
    };
    chip.addEventListener('pointerup', endDrag);
    chip.addEventListener('pointercancel', endDrag);
  });
}

/* =========================================================
   STORAGE
   Priority: Supabase (if the coach has connected it, works
   across every device) > Claude's built-in storage (when
   running inside Claude) > browser localStorage (this device
   only). Same get/set shape either way, so the rest of the
   app never needs to know which one is active.
========================================================= */
function getSupabaseConfig(){
  try{
    const raw = localStorage.getItem('courtside:supabaseConfig');
    return raw ? JSON.parse(raw) : null;
  }catch(e){ return null; }
}
function setSupabaseConfig(cfg){ localStorage.setItem('courtside:supabaseConfig', JSON.stringify(cfg)); }
function clearSupabaseConfig(){ localStorage.removeItem('courtside:supabaseConfig'); }

const supabaseConfig = getSupabaseConfig();
let sb = null;
if(supabaseConfig && supabaseConfig.url && supabaseConfig.anonKey && window.supabase && window.supabase.createClient){
  sb = window.supabase.createClient(supabaseConfig.url, supabaseConfig.anonKey);
}

const usingClaudeStorage = (typeof window.storage !== 'undefined') && window.storage && typeof window.storage.get === 'function';

const store = sb ? {
  async get(key){
    const { data, error } = await sb.from('courtside_kv').select('value').eq('key', key).maybeSingle();
    if(error) throw error;
    if(!data) throw new Error('not found');
    return { key, value: data.value, shared:true };
  },
  async set(key, value){
    const { error } = await sb.from('courtside_kv').upsert({ key, value, updated_at: new Date().toISOString() });
    if(error) throw error;
    return { key, value, shared:true };
  }
} : usingClaudeStorage ? window.storage : {
  async get(key){
    const raw = localStorage.getItem('courtside:'+key);
    if(raw===null) throw new Error('not found');
    return { key, value: raw, shared: false };
  },
  async set(key, value){
    localStorage.setItem('courtside:'+key, value);
    return { key, value, shared: false };
  }
};

async function loadAll(){
  try{
    const [r, g, h] = await Promise.allSettled([
      store.get('roster'),
      store.get('activeGame'),
      store.get('gameHistory'),
    ]);
    if(r.status==='fulfilled' && r.value) roster = JSON.parse(r.value.value);
    if(g.status==='fulfilled' && g.value) activeGame = JSON.parse(g.value.value);
    if(h.status==='fulfilled' && h.value) history = JSON.parse(h.value.value);
  }catch(e){ console.error('load error', e); }
  loaded = true;
  render();
}
async function saveRoster(){
  try{ await store.set('roster', JSON.stringify(roster), false); }
  catch(e){ toast('Could not save roster — check connection'); }
}
async function saveActiveGame(){
  try{ await store.set('activeGame', activeGame ? JSON.stringify(activeGame) : JSON.stringify(null), false); }
  catch(e){ toast('Could not save game — check connection'); }
}
async function saveHistory(){
  try{ await store.set('gameHistory', JSON.stringify(history), false); }
  catch(e){ toast('Could not save history — check connection'); }
}

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._h);
  t._h = setTimeout(()=>t.classList.remove('show'), 2200);
}

