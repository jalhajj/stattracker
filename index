/* ---- Possessions & ratings ----
   Standard estimated-possessions formula: FGA − OREB + TOV + 0.44×FTA,
   applied to each team from its own box score. Offensive Rating is points
   scored per 100 of a team's own possessions; Defensive Rating here is the
   opponent's points per 100 of THEIR possessions — i.e. what the opponent's
   offense did against us, which is the standard proxy for our defense since
   one team's offensive possession is (with end-of-period exceptions ignored)
   the other's defensive one. Net Rating is Offensive minus Defensive. */
function computePossessionStats(g){
  ensureOppStats(g);
  ensureOppScoreFields(g);
  const totals = BLANK_LINE();
  Object.values(g.playerStats).forEach(r=> Object.keys(totals).forEach(k=> totals[k]+= r[k]||0));
  const ourPts = totals.pts;
  const ourPoss = Math.max(0, totals.fga - totals.oreb + totals.tov + 0.44*totals.fta);

  const o = g.oppStats;
  const oppFGA = (o.fg2m+o.fg2a) + (o.fg3m+o.fg3a);
  const oppPts = g.finalOpp!==undefined ? g.finalOpp : (g.oppScore||0);
  const oppPoss = Math.max(0, oppFGA - o.oreb + o.tov + 0.44*o.fta);

  const oRtg = ourPoss>0 ? (ourPts/ourPoss)*100 : null;
  const dRtg = oppPoss>0 ? (oppPts/oppPoss)*100 : null;
  const netRtg = (oRtg!=null && dRtg!=null) ? (oRtg-dRtg) : null;
  return { ourPts, ourPoss, oRtg, oppPts, oppPoss, dRtg, netRtg };
}
// Live games always have g.oppScore; a few very old saved history entries
// might not, so this guards computePossessionStats against a stray undefined.
function ensureOppScoreFields(g){
  if(g.oppScore===undefined && g.finalOpp===undefined) g.oppScore = 0;
}
function possessionBlock(g, teamName){
  const s = computePossessionStats(g);
  if(s.ourPoss===0 && s.oppPoss===0){
    return `<p class="muted" style="margin-top:6px;">Not enough logged yet — possessions need at least a shot attempt, rebound, turnover, or free throw for each team.</p>`;
  }
  const fmt1 = v => v==null ? '—' : v.toFixed(1);
  const tile = (value, label) => `
    <div style="text-align:center; flex:1; min-width:0;">
      <div style="font-size:21px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums;">${value}</div>
      <div class="muted" style="font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; margin-top:2px;">${label}</div>
    </div>`;
  return `
    <p class="muted" style="margin:2px 0 14px; font-size:11px;">Estimated possessions = FGA − OREB + TOV + 0.44×FTA, computed separately for each team.</p>
    <div class="card" style="margin-top:0; padding:14px 12px;">
      <h3 style="font-size:13px; margin-bottom:10px;">${escapeHtml(teamName)}</h3>
      <div style="display:flex; gap:6px;">
        ${tile(s.ourPts, 'Points')}
        ${tile(fmt1(s.ourPoss), 'Possessions')}
        ${tile(fmt1(s.oRtg), 'Off. Rating')}
      </div>
    </div>
    <div class="card" style="padding:14px 12px;">
      <h3 style="font-size:13px; margin-bottom:10px;">${escapeHtml(g.opponent)}</h3>
      <div style="display:flex; gap:6px;">
        ${tile(s.oppPts, 'Points')}
        ${tile(fmt1(s.oppPoss), 'Possessions')}
        ${tile(fmt1(s.dRtg), 'Off. Rating (= your Def. Rating)')}
      </div>
    </div>
    <div class="card" style="text-align:center; padding:14px 12px;">
      <div style="font-size:24px; font-weight:800; font-variant-numeric:tabular-nums; color:${s.netRtg==null?'var(--ink)':(s.netRtg>=0?'#4CC98A':'#E8672E')};">${s.netRtg==null?'—':(s.netRtg>=0?'+':'')+s.netRtg.toFixed(1)}</div>
      <div class="muted" style="font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; margin-top:2px;">Net Rating (Off. − Def.)</div>
    </div>
  `;
}

/* ---- Lineup analysis ----
   Every log entry now carries an `onCourt` snapshot (the reorder rail's top
   five at the moment the play happened — see currentOnCourt). Picking 1–5
   players here filters the log down to plays where ALL of them were on the
   floor together, then re-derives points for/against, rebounds, turnovers,
   shooting splits and fast-break rate from just that slice. Entries logged
   before this feature existed have no `onCourt` field and are excluded from
   every lineup slice (there's no way to know who was on the floor for them). */
function gameRosterPids(g){
  const set = new Set();
  // The current team roster (so the chips show up before anything's even been
  // logged), plus anyone who appears in this game's own log or box score —
  // covers history games where the roster has since changed.
  roster.players.forEach(p=> set.add(p.id));
  (g.log||[]).forEach(e=> (e.onCourt||[]).forEach(pid=> pid!==TEAM_PID && set.add(pid)));
  Object.keys(g.playerStats||{}).forEach(pid=> pid!==TEAM_PID && set.add(pid));
  return [...set];
}
function pidLabel(g, pid){
  if(pid===TEAM_PID) return TEAM_NAME;
  const rec = g.playerStats && g.playerStats[pid];
  if(rec) return `#${rec.number} ${rec.name}`;
  return nameOf(pid);
}
function computeLineupStats(g, selectedPids){
  const s = {
    ptsFor:0, ptsAgainst:0, reb:0, oreb:0, dreb:0, oppOreb:0, oppDreb:0,
    tov:0, tovForced:0, fgm:0, fga:0, tpm:0, tpa:0, ftm:0, fta:0,
    fbAttempts:0, totalAttempts:0, matched:false,
  };
  (g.log||[]).forEach(e=>{
    if(!e.onCourt || !selectedPids.every(pid=> e.onCourt.includes(pid))) return;
    s.matched = true;
    if(e.type==='stat'){
      const inc = e.inc||{};
      s.ptsFor += inc.pts||0; s.reb += inc.reb||0; s.oreb += inc.oreb||0; s.dreb += inc.dreb||0;
      s.tov += inc.tov||0; s.fgm += inc.fgm||0; s.fga += inc.fga||0;
      s.tpm += inc.tpm||0; s.tpa += inc.tpa||0; s.ftm += inc.ftm||0; s.fta += inc.fta||0;
      if(inc.fga){ s.totalAttempts += 1; if(e.fastBreak || e.fbMiss) s.fbAttempts += 1; }
    } else if(e.type==='oppstat'){
      s.ptsAgainst += e.pts||0;
      if(e.key==='oreb') s.oppOreb += 1;
      if(e.key==='dreb') s.oppDreb += 1;
      if(e.key==='tov') s.tovForced += 1;
    } else if(e.type==='opp'){
      s.ptsAgainst += e.delta||0;
    }
  });
  return s;
}
function lineupBlock(g, teamName){
  const pids = gameRosterPids(g);
  if(pids.length===0){
    return `<p class="muted" style="margin-top:6px;">No players logged for this game yet.</p>`;
  }
  lineupSelection = lineupSelection.filter(pid=> pids.includes(pid));
  const chips = `
    <p class="muted" style="margin:2px 0 12px; font-size:11px;">Pick 1–5 players to see how ${escapeHtml(teamName)} performed with exactly that group on the floor together.</p>
    <div class="statpad" style="grid-template-columns:repeat(auto-fill, minmax(96px,1fr)); margin-bottom:14px;">
      ${pids.map(pid=>`
        <button class="stat-btn ${lineupSelection.includes(pid)?'lineup-sel':''}" data-lineup-pid="${escapeHtml(pid)}">
          <div class="lbl">${escapeHtml(pidLabel(g,pid))}</div>
        </button>`).join('')}
    </div>
  `;
  if(lineupSelection.length===0){
    return chips + `<p class="muted">Select at least one player above.</p>`;
  }
  const s = computeLineupStats(g, lineupSelection);
  if(!s.matched){
    return chips + `<p class="muted">No plays logged yet with this exact group on the floor together — either it hasn't happened, or those plays were logged before lineup tracking was on.</p>`;
  }
  const net = s.ptsFor - s.ptsAgainst;
  const pct = (m,a)=> a>0 ? Math.round(m/a*100)+'%' : '—';
  const tile = (value, label) => `
    <div style="text-align:center; flex:1; min-width:0;">
      <div style="font-size:19px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums;">${value}</div>
      <div class="muted" style="font-size:9px; text-transform:uppercase; letter-spacing:.05em; margin-top:2px;">${label}</div>
    </div>`;
  const bar = (label, forVal, againstVal) => {
    const total = forVal+againstVal || 1;
    const pctFor = forVal/total*100;
    return `
    <div style="margin-bottom:10px;">
      <div class="muted" style="font-size:10.5px; margin-bottom:3px; display:flex; justify-content:space-between;"><span>${label}</span><span>${forVal} – ${againstVal}</span></div>
      <div style="height:8px; border-radius:4px; overflow:hidden; display:flex; background:rgba(255,255,255,.08);">
        <div style="width:${pctFor}%; background:var(--make);"></div>
        <div style="width:${100-pctFor}%; background:var(--miss);"></div>
      </div>
    </div>`;
  };
  return chips + `
    <div class="card" style="margin-top:0; padding:14px 12px;">
      <h3 style="font-size:13px; margin-bottom:10px;">${lineupSelection.map(p=>escapeHtml(pidLabel(g,p))).join(' · ')}</h3>
      <div style="display:flex; gap:6px; margin-bottom:14px;">
        ${tile(s.ptsFor, 'Points For')}
        ${tile(s.ptsAgainst, 'Points Against')}
        ${tile((net>=0?'+':'')+net, 'Net')}
      </div>
      ${bar('Points', s.ptsFor, s.ptsAgainst)}
      ${bar('Rebounds', s.reb, s.oppOreb+s.oppDreb)}
      <div style="display:flex; gap:6px; margin:14px 0 6px;">
        ${tile(`${s.fgm}/${s.fga}`, `FG (${pct(s.fgm,s.fga)})`)}
        ${tile(`${s.tpm}/${s.tpa}`, `3PT (${pct(s.tpm,s.tpa)})`)}
        ${tile(`${s.ftm}/${s.fta}`, `FT (${pct(s.ftm,s.fta)})`)}
      </div>
      <div style="display:flex; gap:6px;">
        ${tile(pct(s.tpa,s.fga), '3PT Rate')}
        ${tile(`${s.tov} / ${s.tovForced}`, 'TOV (Us / Forced)')}
        ${tile(pct(s.fbAttempts,s.totalAttempts), 'Fast Break %')}
      </div>
    </div>
  `;
}

/* ---- Scoring development chart ----
   A running point-differential bar chart, one bar per scoring play in the
   order it happened (not per quarter) — bars above the zero line mean our
   team is ahead by that many points at that moment, bars below mean the
   opponent is ahead. This is the "game flow" read coaches actually want:
   momentum and runs, not just a final score. Colors are deliberately not
   the app's UI accent (--accent, #FF7A33): that orange fails the
   dark-surface lightness band for a chart mark, so bars use a validated
   deeper step of the same hue (#E8672E) paired with a blue (#3987E5) — both
   pass the color-blindness and contrast checks together on this dark
   background, and match the "us / opponent" color language already used
   elsewhere (assist & rebound prompts, box score accents).
   The log (g.log) is already in chronological order and is the only place
   that knows *when* each point was scored, so we replay it here rather
   than reusing the per-quarter breakdown. */
function scoringEventDelta(entry){
  if(entry.type==='stat') return entry.inc && entry.inc.pts ? entry.inc.pts : 0;   // our team's points, positive
  if(entry.type==='oppstat') return entry.pts ? -entry.pts : 0;                     // opponent's points, negative
  if(entry.type==='opp') return entry.delta ? -entry.delta : 0;                     // opponent quick-add, negative
  return 0;
}
function scoringDevelopmentDiffs(g){
  let running = 0;
  const diffs = [];
  (g.log||[]).forEach(entry=>{
    const d = scoringEventDelta(entry);
    if(!d) return;
    running += d;
    diffs.push(running);
  });
  return diffs;
}
function niceAxisStep(maxAbs){
  const raw = maxAbs/3 || 1;
  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const norm = raw/mag;
  const step = norm<1.5 ? 1 : norm<3 ? 2 : norm<7 ? 5 : 10;
  return step*mag;
}
function scoringDevelopmentSVG(diffs){
  const barW = 5, gap = diffs.length>60?1:2;
  const left = 28, right = 8, top = 10, bottom = 6;
  const plotH = 170;
  const plotW = Math.max(diffs.length*(barW+gap), 60);
  const w = left+plotW+right, h = top+plotH+bottom;
  const maxAbs = Math.max(1, ...diffs.map(Math.abs));
  const step = niceAxisStep(maxAbs);
  const axisMax = Math.ceil(maxAbs/step)*step || step;
  const zeroY = top + plotH/2;
  const scale = (plotH/2) / axisMax;
  let s = `<svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; display:block;" xmlns="http://www.w3.org/2000/svg">`;
  for(let v=-axisMax; v<=axisMax; v+=step){
    const y = zeroY - v*scale;
    s += `<line x1="${left}" y1="${y.toFixed(1)}" x2="${w-right}" y2="${y.toFixed(1)}" stroke="#2A3438" stroke-width="${v===0?1.2:1}"/>`;
    s += `<text x="${left-5}" y="${(y+3.2).toFixed(1)}" text-anchor="end" font-size="9.5" fill="#5B676D" font-family="Inter,sans-serif">${Math.round(v)}</text>`;
  }
  diffs.forEach((d,i)=>{
    const x = left + i*(barW+gap);
    const barH = Math.max(Math.abs(d)*scale, 1.2);
    const y = d>=0 ? zeroY-barH : zeroY;
    const color = d>=0 ? '#E8672E' : '#3987E5';
    s += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW}" height="${barH.toFixed(1)}" rx="1" fill="${color}"/>`;
  });
  s += '</svg>';
  return `<div style="overflow-x:auto; -webkit-overflow-scrolling:touch;"><div style="min-width:${Math.max(w,300)}px;">${s}</div></div>`;
}
function scoringDevelopmentBlock(g, teamName){
  const diffs = scoringDevelopmentDiffs(g);
  if(diffs.length===0) return '';
  const final = diffs[diffs.length-1];
  return `
  <div class="card" style="margin-top:0;">
    <h3 style="font-size:14px;">Scoring Development</h3>
    <div class="muted" style="display:flex; gap:14px; margin:4px 0 10px; font-size:12px; align-items:center;">
      <span><span style="display:inline-block;width:9px;height:9px;border-radius:3px;background:#E8672E;margin-right:5px;"></span>${escapeHtml(teamName)} ahead</span>
      <span><span style="display:inline-block;width:9px;height:9px;border-radius:3px;background:#3987E5;margin-right:5px;"></span>${escapeHtml(g.opponent)} ahead</span>
    </div>
    ${scoringDevelopmentSVG(diffs)}
    <p class="muted" style="margin:8px 0 0; font-size:11.5px;">Running point differential after each score · currently ${final>0?`${escapeHtml(teamName)} +${final}`:final<0?`${escapeHtml(g.opponent)} +${-final}`:'tied'}</p>
  </div>`;
}

/* ---- Assist heatmap: who assists whom ----
   Replays g.log for assist entries tagged with scorerPid (set at the moment
   the assist is logged, see openAssistPromptModal) and builds a
   {assisterPid: {scorerPid: count}} matrix. Rendered as rows = "assisted by",
   columns = "scorer". Player identity comes from g.playerStats (not the live
   roster) so a game stays correct even if the roster changes later. */
function computeAssistHeatmap(g){
  const pairs = {};
  let maxCount = 0;
  (g.log||[]).forEach(entry=>{
    if(entry.type==='stat' && entry.key==='ast' && entry.scorerPid){
      const a = entry.pid, s = entry.scorerPid;
      if(!pairs[a]) pairs[a] = {};
      if(!pairs[a][s]) pairs[a][s] = { count:0, fastBreaks:0, zones:{} };
      const cell = pairs[a][s];
      cell.count += 1;
      if(entry.scorerFastBreak) cell.fastBreaks += 1;
      if(entry.scorerLocation) cell.zones[entry.scorerLocation] = (cell.zones[entry.scorerLocation]||0) + 1;
      if(cell.count > maxCount) maxCount = cell.count;
    }
  });
  const rosterOrder = roster.players.map(p=>p.id);
  const orderIds = ids => {
    const known = rosterOrder.filter(id=> ids.has(id));
    const unknown = [...ids].filter(id=> !rosterOrder.includes(id));
    return known.concat(unknown);
  };
  const assisterIds = new Set(Object.keys(pairs));
  const scorerIds = new Set();
  Object.values(pairs).forEach(row=> Object.keys(row).forEach(id=> scorerIds.add(id)));
  return {
    pairs,
    maxCount,
    assisters: orderIds(assisterIds),
    scorers: orderIds(scorerIds)
  };
}
/* Sequential single-hue ramp for a dark surface: low counts recede toward
   the panel background (#1A2226) rather than going dark/black, high counts
   pop as a bright saturated blue — the inverse of a light-surface ramp,
   per the dataviz skill's dark-mode guidance. 3-anchor RGB lerp. */
function heatColor(f){
  const stops = [
    [0x1A,0x22,0x26],   // f=0: panel background — recedes
    [0x2A,0x63,0xA0],   // f=0.5: mid blue
    [0x8E,0xC4,0xFB]    // f=1: bright blue — pops
  ];
  const seg = f<=0.5 ? [stops[0],stops[1],f/0.5] : [stops[1],stops[2],(f-0.5)/0.5];
  const [c0,c1,t] = seg;
  const mix = (a,b)=> Math.round(a + (b-a)*t);
  return `rgb(${mix(c0[0],c1[0])},${mix(c0[1],c1[1])},${mix(c0[2],c1[2])})`;
}
function assistHeatmapBlock(g){
  const { pairs, maxCount, assisters, scorers } = computeAssistHeatmap(g);
  if(assisters.length===0 || scorers.length===0) return '';
  const label = pid=>{
    const p = g.playerStats[pid];
    return p ? `#${escapeHtml(p.number)} ${escapeHtml(p.name)}` : pid;
  };
  const shortLabel = pid=>{
    const p = g.playerStats[pid];
    return p ? escapeHtml(p.name) : pid;
  };
  return `
  <div class="card" style="margin-top:0;">
    <h3 style="font-size:14px;">Assists — Who Feeds Whom</h3>
    <div style="display:flex; gap:6px; align-items:stretch; margin-top:8px;">
      <div class="heat-axis-label" style="writing-mode:vertical-rl; transform:rotate(180deg);">Assisted by</div>
      <div style="flex:1; min-width:0;">
        <div class="heat-axis-label" style="text-align:center; margin-bottom:4px;">Scored by</div>
        <div class="table-scroll">
        <table class="heatmap">
          <thead><tr>
            <th></th>
            ${scorers.map(s=>`<th title="${label(s)}">${shortLabel(s)}</th>`).join('')}
          </tr></thead>
          <tbody>
            ${assisters.map(a=>`
              <tr>
                <td class="heat-rowlabel" title="${label(a)}">${shortLabel(a)}</td>
                ${scorers.map(s=>{
                  const cell = (pairs[a] && pairs[a][s]) || null;
                  const count = cell ? cell.count : 0;
                  const f = maxCount>0 ? count/maxCount : 0;
                  const bg = count>0 ? heatColor(f) : 'transparent';
                  const textColor = f>0.55 ? '#0B0F11' : 'var(--ink)';
                  let tip = `${label(a)} → ${label(s)}: ${count}`;
                  if(cell && count>0){
                    if(cell.fastBreaks>0) tip += ` (${cell.fastBreaks} on fast breaks)`;
                    const topZoneEntry = Object.entries(cell.zones).sort((x,y)=>y[1]-x[1])[0];
                    if(topZoneEntry) tip += ` · mostly ${shotZoneLabel(topZoneEntry[0]) || topZoneEntry[0]}`;
                  }
                  return `<td class="heat-cell" title="${escapeHtml(tip)}" style="background:${bg}; color:${textColor};">${count>0?count:''}</td>`;
                }).join('')}
              </tr>`).join('')}
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>`;
}

/* ---- Shot chart: aggregated shot locations on a half court ----
   Reuses the SHOT_ZONES vocabulary captured by openShotLocationModal, which
   now runs on misses as well as makes. Zones are drawn as radial wedges
   around the hoop (near/far = inside/outside the 3pt band, angle =
   left/center/right) rather than hand-placed rectangles, so the picture is a
   real half-court shape, not a grid. Filled with the same dark-surface
   sequential ramp as the assist heatmap (heatColor) so the two charts read
   consistently, plus a "makes/attempts" label on every wedge and a text
   legend underneath — never color alone. */
function computeShotZoneStats(g){
  const stats = {};
  SHOT_ZONES.forEach(z=> stats[z.key] = { makes:0, attempts:0 });
  (g.log||[]).forEach(e=>{
    if(e.type!=='stat' || !e.location || !stats.hasOwnProperty(e.location)) return;
    if(e.key==='fg2m' || e.key==='fg3m'){ stats[e.location].makes += 1; stats[e.location].attempts += 1; }
    else if(e.key==='fg2a' || e.key==='fg3a'){ stats[e.location].attempts += 1; }
  });
  return stats;
}
// theta is degrees from "straight up-court" (away from the baseline),
// positive to the right — 0 = top of the key, ±90 = the sidelines at the
// hoop's own height. Polar-to-cartesian around the hoop; SVG y grows down,
// so "up" is -y.
function polarPoint(hoop, r, thetaDeg){
  const rad = thetaDeg * Math.PI/180;
  return [hoop.x + r*Math.sin(rad), hoop.y - r*Math.cos(rad)];
}
// Traces the arc as a short polyline (not an SVG arc command) so there's no
// large-arc/sweep-flag direction to get wrong — just walk theta in small
// steps and connect the dots.
function arcPolyline(hoop, r, theta1, theta2, steps){
  const pts = [];
  for(let i=0;i<=steps;i++){
    const t = theta1 + (theta2-theta1)*(i/steps);
    pts.push(polarPoint(hoop, r, t));
  }
  return pts;
}
function wedgePath(hoop, rInner, rOuter, theta1, theta2){
  const steps = 14;
  const outer = arcPolyline(hoop, rOuter, theta1, theta2, steps);
  const fmt = p => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
  if(rInner<=0){
    return `M ${fmt([hoop.x,hoop.y])} L ${outer.map(fmt).join(' L ')} Z`;
  }
  const inner = arcPolyline(hoop, rInner, theta2, theta1, steps); // reversed, to close the ring
  return `M ${fmt(outer[0])} L ${outer.slice(1).map(fmt).join(' L ')} L ${inner.map(fmt).join(' L ')} Z`;
}
// Single source of truth for every court measurement — both the drawn court
// lines and the colored zone shapes read from this, so a zone boundary can
// never drift away from the line it's supposed to sit against (that
// mismatch — zones cut off well short of the real 3pt line, corners drawn as
// angle wedges instead of following the actual straight sideline segment —
// was the "overlapping" the zones didn't line up with the court).
function courtGeometry(hoop, w){
  const laneHalfW = 55;
  const laneTopY = hoop.y - 150;
  const ftCircleR = 45;
  const restrictedR = 40;
  const threeR = 185;       // 3pt arc radius
  const threeOuterR = 230;  // outer edge of the "beyond the arc" zone band
  const cornerInset = 35;   // how far the corner-3 line sits in from the sideline
  const cornerX1 = 10 + cornerInset;
  const cornerX2 = (w-10) - cornerInset;
  const angleDeg = Math.asin(Math.min(1, (hoop.x-cornerX1)/threeR)) * 180/Math.PI; // angle where the arc meets the straight corner line
  const cornerTopY = hoop.y - threeR*Math.cos(angleDeg*Math.PI/180);
  const baselineY = hoop.y + 8;
  const wingCut = 20; // degrees splitting "wing" from "top of key" within the arc band
  return { laneHalfW, laneTopY, ftCircleR, restrictedR, threeR, threeOuterR, cornerInset, cornerX1, cornerX2, angleDeg, cornerTopY, baselineY, wingCut };
}
// Draws recognizable half-court markings — baseline, backboard, rim, the
// lane/key, a dashed free-throw circle, and the three-point line (straight
// corner segments plus the arc) — as strokes only, on top of the colored
// zone shapes, in a light, semi-transparent line color so they read clearly
// against every zone's shade without hiding the fills underneath.
function courtLinesSVG(hoop, w){
  const c = courtGeometry(hoop, w);
  const stroke = 'rgba(214,224,228,0.55)';
  let s = '';
  s += `<line x1="10" y1="${c.baselineY}" x2="${w-10}" y2="${c.baselineY}" stroke="${stroke}" stroke-width="2"/>`;
  s += `<line x1="${hoop.x-22}" y1="${(hoop.y+5).toFixed(1)}" x2="${hoop.x+22}" y2="${(hoop.y+5).toFixed(1)}" stroke="${stroke}" stroke-width="2.5"/>`;
  s += `<circle cx="${hoop.x}" cy="${hoop.y}" r="7" fill="none" stroke="${stroke}" stroke-width="2"/>`;
  s += `<rect x="${hoop.x-c.laneHalfW}" y="${c.laneTopY}" width="${c.laneHalfW*2}" height="${(c.baselineY-c.laneTopY).toFixed(1)}" fill="none" stroke="${stroke}" stroke-width="1.5"/>`;
  s += `<circle cx="${hoop.x}" cy="${c.laneTopY}" r="${c.ftCircleR}" fill="none" stroke="${stroke}" stroke-width="1.5" stroke-dasharray="4 3"/>`;
  s += `<line x1="${c.cornerX1}" y1="${c.baselineY}" x2="${c.cornerX1}" y2="${c.cornerTopY.toFixed(1)}" stroke="${stroke}" stroke-width="1.5"/>`;
  s += `<line x1="${c.cornerX2}" y1="${c.baselineY}" x2="${c.cornerX2}" y2="${c.cornerTopY.toFixed(1)}" stroke="${stroke}" stroke-width="1.5"/>`;
  const arcPts = arcPolyline(hoop, c.threeR, -c.angleDeg, c.angleDeg, 24);
  s += `<polyline points="${arcPts.map(p=>`${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ')}" fill="none" stroke="${stroke}" stroke-width="1.5"/>`;
  return s;
}
// Builds each zone's fill shape from the exact same numbers courtLinesSVG
// draws with, so a zone's colored region always sits flush against the real
// court line it borders: the paint is the actual lane rectangle, mid-range
// is bounded outward by the true 3pt line (arc + corner), the corners are
// rectangles beyond the real corner line, and wing/top are bands starting
// exactly at the arc — not a fixed radius that happens to land nearby.
function buildShotZoneShapes(hoop, w){
  const c = courtGeometry(hoop, w);
  const fmt = p => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
  const poly = pts => `M ${pts.map(fmt).join(' L ')} Z`;
  const laneLeft = hoop.x - c.laneHalfW, laneRight = hoop.x + c.laneHalfW;
  const midSteps = 12;
  const shapes = {};

  shapes.restricted = {
    d: wedgePath(hoop, 0, c.restrictedR, -90, 90),
    label: polarPoint(hoop, c.restrictedR*0.55, 0),
  };
  shapes.paint = {
    // the full lane rectangle — restricted is drawn on top of it after, so
    // the two read as distinct regions even though this one runs underneath
    d: poly([[laneLeft,c.laneTopY],[laneRight,c.laneTopY],[laneRight,c.baselineY],[laneLeft,c.baselineY]]),
    label: [hoop.x, c.laneTopY + 24],
  };
  shapes.lmid = {
    d: poly([
      [laneLeft, c.laneTopY],
      [hoop.x, c.laneTopY],
      ...arcPolyline(hoop, c.threeR, 0, -c.angleDeg, midSteps),
      [c.cornerX1, c.baselineY],
      [laneLeft, c.baselineY],
    ]),
    label: polarPoint(hoop, 100, -c.angleDeg*0.55),
  };
  shapes.rmid = {
    d: poly([
      [hoop.x, c.laneTopY],
      [laneRight, c.laneTopY],
      [laneRight, c.baselineY],
      [c.cornerX2, c.baselineY],
      [c.cornerX2, c.cornerTopY],
      ...arcPolyline(hoop, c.threeR, c.angleDeg, 0, midSteps),
    ]),
    label: polarPoint(hoop, 100, c.angleDeg*0.55),
  };
  shapes.lcorner3 = {
    d: poly([[10,c.baselineY],[c.cornerX1,c.baselineY],[c.cornerX1,c.cornerTopY],[10,c.cornerTopY]]),
    label: [(10+c.cornerX1)/2, (c.cornerTopY+c.baselineY)/2],
  };
  shapes.rcorner3 = {
    d: poly([[c.cornerX2,c.baselineY],[w-10,c.baselineY],[w-10,c.cornerTopY],[c.cornerX2,c.cornerTopY]]),
    label: [(c.cornerX2+(w-10))/2, (c.cornerTopY+c.baselineY)/2],
  };
  shapes.lwing3 = {
    d: wedgePath(hoop, c.threeR, c.threeOuterR, -c.angleDeg, -c.wingCut),
    label: polarPoint(hoop, (c.threeR+c.threeOuterR)/2, -(c.angleDeg+c.wingCut)/2),
  };
  shapes.top3 = {
    d: wedgePath(hoop, c.threeR, c.threeOuterR, -c.wingCut, c.wingCut),
    label: polarPoint(hoop, (c.threeR+c.threeOuterR)/2, 0),
  };
  shapes.rwing3 = {
    d: wedgePath(hoop, c.threeR, c.threeOuterR, c.wingCut, c.angleDeg),
    label: polarPoint(hoop, (c.threeR+c.threeOuterR)/2, (c.angleDeg+c.wingCut)/2),
  };
  return shapes;
}
// Draw order matters: 'paint' before 'restricted' so the restricted-area
// circle visibly sits on top of the lane rectangle instead of underneath it.
const SHOT_ZONE_DRAW_ORDER = ['paint','restricted','lmid','rmid','lcorner3','rcorner3','lwing3','top3','rwing3'];
function shotChartSVG(stats){
  const hoop = { x:210, y:380 };
  const w = 420, h = 400;
  const shapes = buildShotZoneShapes(hoop, w);
  const maxMakes = Math.max(1, ...Object.values(stats).map(s=>s.makes));
  let s = `<svg viewBox="0 0 ${w} ${h}" style="width:100%; max-width:340px; height:auto; display:block; margin:0 auto;" xmlns="http://www.w3.org/2000/svg">`;
  s += `<rect x="10" y="10" width="${w-20}" height="${hoop.y-2}" fill="none" stroke="#2A3438" stroke-width="1.5" rx="6"/>`;
  SHOT_ZONE_DRAW_ORDER.forEach(key=>{
    const cell = stats[key] || {makes:0,attempts:0};
    const f = cell.makes/maxMakes;
    const fill = cell.attempts>0 ? heatColor(f) : 'rgba(255,255,255,0.035)';
    s += `<path d="${shapes[key].d}" fill="${fill}" stroke="#0F1416" stroke-width="2"/>`;
  });
  s += courtLinesSVG(hoop, w);
  SHOT_ZONE_DRAW_ORDER.forEach(key=>{
    const cell = stats[key] || {makes:0,attempts:0};
    if(!cell.attempts) return;
    const f = cell.makes/maxMakes;
    const [lx,ly] = shapes[key].label;
    const textColor = f>0.55 ? '#0B0F11' : '#E7ECEE';
    s += `<text x="${lx.toFixed(1)}" y="${(ly+6).toFixed(1)}" text-anchor="middle" font-size="15" font-weight="700" fill="${textColor}" font-family="Inter,sans-serif">${cell.makes}/${cell.attempts}</text>`;
  });
  s += '</svg>';
  return s;
}
function shotChartBlock(g, teamName){
  const stats = computeShotZoneStats(g);
  const zonesWithData = SHOT_ZONES.filter(z=> stats[z.key].attempts>0);
  const totalMakes = zonesWithData.reduce((a,z)=> a+stats[z.key].makes, 0);
  const totalAttempts = zonesWithData.reduce((a,z)=> a+stats[z.key].attempts, 0);
  if(totalAttempts===0){
    return `<p class="muted" style="margin-top:6px;">No shots with a location logged yet — pick a spot on the "Where was the shot?" prompt after your next 2PT/3PT attempt to start building this chart.</p>`;
  }
  const pct = totalAttempts>0 ? (totalMakes/totalAttempts*100) : 0;
  const sortedZones = zonesWithData.slice().sort((a,b)=> stats[b.key].attempts-stats[a.key].attempts);
  return `
    <div style="display:flex; gap:26px; justify-content:center; margin:4px 0 14px;">
      <div style="text-align:center;">
        <div style="font-size:23px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums;">${totalMakes}/${totalAttempts}</div>
        <div class="muted" style="font-size:10px; text-transform:uppercase; letter-spacing:.05em; margin-top:2px;">Located FG</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:23px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums;">${pct.toFixed(1)}%</div>
        <div class="muted" style="font-size:10px; text-transform:uppercase; letter-spacing:.05em; margin-top:2px;">FG%</div>
      </div>
    </div>
    <p class="muted" style="margin:0 0 10px; font-size:11px; text-align:center;">${escapeHtml(teamName)} · each zone shows makes/attempts, shaded by makes</p>
    ${shotChartSVG(stats)}
    <div class="muted" style="display:flex; flex-wrap:wrap; gap:6px 16px; margin-top:14px; font-size:11.5px; justify-content:center;">
      ${sortedZones.map(z=>{
        const c = stats[z.key];
        const zonePct = c.attempts>0 ? (c.makes/c.attempts*100).toFixed(0) : '0';
        return `<span><b style="color:var(--ink)">${c.makes}/${c.attempts}</b> ${escapeHtml(z.label)} (${zonePct}%)</span>`;
      }).join('')}
    </div>
  `;
}

/* ---- CSV export ---- */
function csvEscape(v){
  v = String(v==null?'':v);
  if(/[",\n]/.test(v)) v = '"'+v.replace(/"/g,'""')+'"';
  return v;
}
function toCSV(rows){ return rows.map(r=> r.map(csvEscape).join(',')).join('\r\n'); }
function downloadCSV(filename, rows){
  const csv = toCSV(rows);
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 1000);
}
function csvFilename(g){
  const d = new Date(g.date);
  const safeOpp = String(g.opponent||'opponent').replace(/[^a-z0-9]+/gi,'_');
  return `game_${d.toISOString().slice(0,10)}_vs_${safeOpp}.csv`;
}

const QUARTER_ORDER = ['Q1','Q2','Q3','Q4','OT'];

// Replays a game's action log to build per-quarter breakdowns. The log is
// the source of truth for "what happened when" — playerStats/oppStats only
// hold running totals. Log entries written before quarter-tagging existed
// have no `quarter` field and are bucketed into Q1 so old saved games still
// export instead of erroring.
function computeGameBreakdown(g){
  const playerQ = {};   // pid -> quarter -> stat line
  const oppQ = {};      // quarter -> {..opp counters, rawPts}
  const fbQ = {};       // quarter -> {usPts, usMiss, oppPts, oppMiss}
  const ensurePlayerQ = (pid,q)=>{ playerQ[pid] = playerQ[pid]||{}; playerQ[pid][q] = playerQ[pid][q] || BLANK_LINE(); return playerQ[pid][q]; };
  const ensureOppQ = (q)=>{ oppQ[q] = oppQ[q] || Object.assign(BLANK_OPP(), {rawPts:0}); return oppQ[q]; };
  const ensureFbQ = (q)=>{ fbQ[q] = fbQ[q] || {usPts:0,usMiss:0,oppPts:0,oppMiss:0}; return fbQ[q]; };
  (g.log||[]).forEach(entry=>{
    const q = entry.quarter || 'Q1';
    if(entry.type==='stat'){
      const line = ensurePlayerQ(entry.pid, q);
      Object.entries(entry.inc).forEach(([k,v])=>{ line[k] = (line[k]||0) + v; });
      if(entry.fbPts) ensureFbQ(q).usPts += entry.fbPts;
      if(entry.fbMiss) ensureFbQ(q).usMiss += 1;
    } else if(entry.type==='oppstat'){
      const o = ensureOppQ(q);
      o[entry.key] = (o[entry.key]||0) + 1;
      if(entry.fbPts) ensureFbQ(q).oppPts += entry.fbPts;
      if(entry.fbMiss) ensureFbQ(q).oppMiss += 1;
    } else if(entry.type==='opp'){
      ensureOppQ(q).rawPts += entry.delta;
    }
  });
  return { playerQ, oppQ, fbQ };
}

function gameCSVRows(g, teamName){
  ensureOppStats(g);
  ensureFastBreak(g);
  const { playerQ, oppQ, fbQ } = computeGameBreakdown(g);
  const rows = [];

  rows.push([`${teamName} — by quarter`]);
  rows.push(['Quarter','Player','Number','PTS','REB','OREB','DREB','AST','STL','BLK','TOV','PF','FGM','FGA','3PM','3PA','FTM','FTA']);
  Object.entries(g.playerStats).forEach(([pid, total])=>{
    QUARTER_ORDER.forEach(q=>{
      const line = playerQ[pid] && playerQ[pid][q];
      if(!line) return;
      rows.push([q, total.name, total.number, line.pts,line.reb,line.oreb,line.dreb,line.ast,line.stl,line.blk,line.tov,line.pf,line.fgm,line.fga,line.tpm,line.tpa,line.ftm,line.fta]);
    });
    rows.push(['Total', total.name, total.number, total.pts,total.reb,total.oreb,total.dreb,total.ast,total.stl,total.blk,total.tov,total.pf,total.fgm,total.fga,total.tpm,total.tpa,total.ftm,total.fta]);
  });
  rows.push([]);

  rows.push([`${g.opponent} — by quarter`]);
  rows.push(['Quarter','2PM','2PA','3PM','3PA','OREB','DREB','TOV','FTA','PF','QuickAddPts']);
  let oppRawPtsTotal = 0;
  QUARTER_ORDER.forEach(q=>{
    const o = oppQ[q];
    if(!o) return;
    oppRawPtsTotal += o.rawPts;
    rows.push([q, o.fg2m, o.fg2m+o.fg2a, o.fg3m, o.fg3m+o.fg3a, o.oreb, o.dreb, o.tov, o.fta, o.pf, o.rawPts]);
  });
  const oTot = g.oppStats;
  rows.push(['Total', oTot.fg2m, oTot.fg2m+oTot.fg2a, oTot.fg3m, oTot.fg3m+oTot.fg3a, oTot.oreb, oTot.dreb, oTot.tov, oTot.fta, oTot.pf, oppRawPtsTotal]);
  rows.push([]);

  rows.push(['Fast break — by quarter']);
  rows.push(['Quarter', `${teamName}_Pts`, `${teamName}_Miss`, `${g.opponent}_Pts`, `${g.opponent}_Miss`]);
  QUARTER_ORDER.forEach(q=>{
    const fb = fbQ[q];
    if(!fb) return;
    rows.push([q, fb.usPts, fb.usMiss, fb.oppPts, fb.oppMiss]);
  });
  rows.push(['Total', g.fastBreak.us, g.fastBreak.usMiss, g.fastBreak.opp, g.fastBreak.oppMiss]);
  rows.push([]);

  const teamTotal = g.finalTeam!==undefined ? g.finalTeam : totalPts(g.playerStats);
  const oppTotal = g.finalOpp!==undefined ? g.finalOpp : g.oppScore;
  rows.push(['Final score', teamName, teamTotal, 'vs', g.opponent, oppTotal]);
  return rows;
}
function seasonCSVRows(){
  const header = ['Date','Opponent','Result','Player','Number','PTS','REB','OREB','DREB','AST','STL','BLK','TOV','PF','FGM','FGA','3PM','3PA','FTM','FTA','Opp_2PM','Opp_2PA','Opp_3PM','Opp_3PA','Opp_OREB','Opp_DREB','Opp_TOV','Opp_FTA','Opp_PF','FastBreakPts_Us','FastBreakMiss_Us','FastBreakPts_Opp','FastBreakMiss_Opp'];
  const rows = [header];
  history.forEach(g=>{
    ensureOppStats(g);
    ensureFastBreak(g);
    const dateStr = new Date(g.date).toISOString().slice(0,10);
    Object.values(g.playerStats).forEach(l=>{
      rows.push([dateStr, g.opponent, g.result, l.name, l.number, l.pts,l.reb,l.oreb,l.dreb,l.ast,l.stl,l.blk,l.tov,l.pf,l.fgm,l.fga,l.tpm,l.tpa,l.ftm,l.fta,
        g.oppStats.fg2m, g.oppStats.fg2m+g.oppStats.fg2a, g.oppStats.fg3m, g.oppStats.fg3m+g.oppStats.fg3a,
        g.oppStats.oreb, g.oppStats.dreb, g.oppStats.tov, g.oppStats.fta, g.oppStats.pf,
        g.fastBreak.us, g.fastBreak.usMiss, g.fastBreak.opp, g.fastBreak.oppMiss]);
    });
  });
  return rows;
}

// Shot-zone options for the "where was the shot?" prompt shown right after a
// 2PT/3PT field goal (make OR miss) by one of our players, before the
// assist/rebound prompt. Each zone is tagged 2 or 3 so the prompt only ever
// offers zones that are actually worth that shot's points — no picking a
// corner 3 for a shot worth 2. Ordered near-to-far within each shot type.
const SHOT_ZONES = [
  { key:'restricted', label:'Restricted Area', type:2 },
  { key:'paint',       label:'Paint',           type:2 },
  { key:'lmid',        label:'Left Mid-Range',  type:2 },
  { key:'rmid',        label:'Right Mid-Range', type:2 },
  { key:'top3',        label:'Top of Key 3',    type:3 },
  { key:'lwing3',      label:'Left Wing 3',     type:3 },
  { key:'rwing3',      label:'Right Wing 3',    type:3 },
  { key:'lcorner3',    label:'Left Corner 3',   type:3 },
  { key:'rcorner3',    label:'Right Corner 3',  type:3 },
];
function shotZoneLabel(key){
  const z = SHOT_ZONES.find(z=>z.key===key);
  return z ? z.label : null;
}
// Tags the just-logged shot (make or miss) with where it happened, then
// hands off to `next` (the assist prompt for a make, the rebound prompt for
// a miss). Runs for every 2PT/3PT field goal attempt by a real player,
// whether or not it went in, because the location belongs to the shot
// itself. Only offers zones matching the shot's own point value (2 vs 3) so
// a 2PT attempt can't be tagged to a 3-point zone or vice versa.
function openShotLocationModal(g, shooterPid, action, next){
  const isThree = action.key === 'fg3m' || action.key === 'fg3a';
  const isMake = action.key === 'fg2m' || action.key === 'fg3m';
  const zones = SHOT_ZONES.filter(z=> z.type === (isThree?3:2));
  const leadAlone = zones.length % 2 === 1; // an odd zone count gets a full-width lead row
  showModal(`
    <h3>Where was the shot?</h3>
    <p class="muted" style="margin-bottom:10px;">${escapeHtml(nameOf(shooterPid))}'s ${isThree?'3PT':'2PT'} ${isMake?'make':'miss'} — tap the spot, or skip.</p>
    <div class="statpad" style="grid-template-columns:repeat(2,1fr);">
      ${zones.map((z,i)=>`
        <button class="stat-btn" data-zone="${z.key}" ${i===0 && leadAlone ? 'style="grid-column:span 2;"' : ''}>
          <div class="lbl">${z.label}</div>
        </button>`).join('')}
    </div>
    <button class="btn block" id="zoneSkipBtn" style="margin-top:12px;">Skip</button>
  `);
  const finish = (zoneKey)=>{
    const lastEntry = g.log[g.log.length-1];
    if(lastEntry && lastEntry.type==='stat' && lastEntry.pid===shooterPid){
      lastEntry.location = zoneKey || null;
    }
    saveActiveGame();
    closeModal();
    next();
  };
  document.querySelectorAll('[data-zone]').forEach(btn=> btn.onclick = ()=> finish(btn.dataset.zone));
  document.getElementById('zoneSkipBtn').onclick = ()=> finish(null);
}

// Prompts for who got the assist right after a made shot, restricted to the
// coach's on-court five — the first 5 entries of roster.players, which the
// reorder feature keeps matched to who's actually on the floor. The shooter
// is excluded (can't assist your own basket); "No Assist" just closes it.
function openAssistPromptModal(g, shooterPid){
  const onCourt = roster.players.slice(0,5).filter(p=>p.id!==shooterPid);
  if(onCourt.length===0) return; // nobody else on the floor to credit — skip silently
  showModal(`
    <h3>Who got the assist?</h3>
    <p class="muted" style="margin-bottom:10px;">${escapeHtml(nameOf(shooterPid))}'s make — pick from your on-court five, or skip.</p>
    <div class="statpad" style="grid-template-columns:repeat(2,1fr);">
      ${onCourt.map(p=>`
        <button class="stat-btn" data-assist="${p.id}">
          <div class="lbl">#${escapeHtml(p.number)} ${escapeHtml(p.name)}</div>
        </button>`).join('')}
    </div>
    <button class="btn block" id="noAssistBtn" style="margin-top:12px;">No Assist</button>
  `);
  document.querySelectorAll('[data-assist]').forEach(btn=> btn.onclick = ()=>{
    const pid = btn.dataset.assist;
    if(!g.playerStats[pid]){
      const p = roster.players.find(pp=>pp.id===pid);
      g.playerStats[pid] = Object.assign(BLANK_LINE(), {name:p.name, number:p.number});
    }
    const assistAction = STAT_ACTIONS.find(a=>a.key==='ast');
    applyStat(g, pid, assistAction);
    // Tag the log entry with who was fed, so the assist heatmap can replay
    // the log and pair every assist with its scorer. Nothing else reads this
    // field, so it can't interfere with undo (which only touches `inc`).
    // Also copy over the scorer's shot location and fast-break flag from
    // their own make entry (set moments earlier by openShotLocationModal /
    // applyStat) so every assist carries where it happened and whether it
    // came off a fast break, without needing to cross-reference the log.
    const lastEntry = g.log[g.log.length-1];
    if(lastEntry && lastEntry.type==='stat' && lastEntry.key==='ast'){
      lastEntry.scorerPid = shooterPid;
      const shotEntry = [...g.log].reverse().find(e=> e.type==='stat' && e.pid===shooterPid && ASSIST_TRIGGER_KEYS.includes(e.key));
      if(shotEntry){
        lastEntry.scorerLocation = shotEntry.location || null;
        lastEntry.scorerFastBreak = !!shotEntry.fastBreak;
      }
    }
    saveActiveGame();
    closeModal();
    render();
  });
  document.getElementById('noAssistBtn').onclick = closeModal;
}

// Prompts for what happened to the rebound right after a missed shot (2PT,
// 3PT, or free throw) by one of our players. Mirrors the assist-prompt
// pattern: fires once, right after the miss is logged. A defensive rebound
// always goes to the opponent (team-level, same as the Opponent tab's own
// Def. Rebound button); an offensive rebound is ours, so it drills into a
// second step to credit a player — restricted to the on-court five, same
// rule as the assist prompt — plus an explicit "Team Rebound" option for
// when the coach saw the rebound but not who grabbed it.
function openReboundPromptModal(g, shooterPid){
  showModal(`
    <h3>Who got the rebound?</h3>
    <p class="muted" style="margin-bottom:10px;">${escapeHtml(nameOf(shooterPid))}'s miss — pick what happened, or skip.</p>
    <button class="btn primary block" id="rebOffBtn" style="margin-bottom:10px;">Offensive Rebound — ${escapeHtml(roster.teamName)}</button>
    <button class="btn block" id="rebDefBtn" style="margin-bottom:10px;">Defensive Rebound — ${escapeHtml(g.opponent)}</button>
    <button class="btn block" id="rebSkipBtn">Skip</button>
  `);
  document.getElementById('rebOffBtn').onclick = ()=> openOffensiveReboundPlayerModal(g, shooterPid);
  document.getElementById('rebDefBtn').onclick = ()=>{
    applyOppStat(g, 'dreb');
    saveActiveGame();
    closeModal();
    render();
  };
  document.getElementById('rebSkipBtn').onclick = closeModal;
}

function openOffensiveReboundPlayerModal(g, shooterPid){
  const onCourt = roster.players.slice(0,5);
  showModal(`
    <h3>Who grabbed it?</h3>
    <p class="muted" style="margin-bottom:10px;">Offensive rebound — pick from your on-court five, or credit the team.</p>
    <div class="statpad" style="grid-template-columns:repeat(2,1fr);">
      ${onCourt.map(p=>`
        <button class="stat-btn" data-oreb="${p.id}">
          <div class="lbl">#${escapeHtml(p.number)} ${escapeHtml(p.name)}</div>
        </button>`).join('')}
      <button class="stat-btn" data-oreb="${TEAM_PID}">
        <div class="lbl">Team Rebound</div>
      </button>
    </div>
    <button class="btn block" id="rebBackBtn" style="margin-top:12px;">Back</button>
  `);
  document.querySelectorAll('[data-oreb]').forEach(btn=> btn.onclick = ()=>{
    const pid = btn.dataset.oreb;
    if(!g.playerStats[pid]){
      if(pid===TEAM_PID){
        g.playerStats[TEAM_PID] = Object.assign(BLANK_LINE(), {name:TEAM_NAME, number:TEAM_NUMBER});
      } else {
        const p = roster.players.find(pp=>pp.id===pid);
        g.playerStats[pid] = Object.assign(BLANK_LINE(), {name:p.name, number:p.number});
      }
    }
    const orebAction = STAT_ACTIONS.find(a=>a.key==='oreb');
    applyStat(g, pid, orebAction);
    saveActiveGame();
    closeModal();
    render();
  });
  document.getElementById('rebBackBtn').onclick = ()=> openReboundPromptModal(g, shooterPid);
}

// Mirror of openReboundPromptModal for the Opponent tab: fires after THEIR
// missed field goal. The sides are swapped from the player-miss version —
// their miss means a defensive rebound is ours (needs a player picker) and
// an offensive rebound is theirs (team-level tally only, same as any other
// opponent stat).
function openOppReboundPromptModal(g){
  showModal(`
    <h3>Who got the rebound?</h3>
    <p class="muted" style="margin-bottom:10px;">${escapeHtml(g.opponent)}'s miss — pick what happened, or skip.</p>
    <button class="btn primary block" id="oppRebDefBtn" style="margin-bottom:10px;">Defensive Rebound — ${escapeHtml(roster.teamName)}</button>
    <button class="btn block" id="oppRebOffBtn" style="margin-bottom:10px;">Offensive Rebound — ${escapeHtml(g.opponent)}</button>
    <button class="btn block" id="oppRebSkipBtn">Skip</button>
  `);
  document.getElementById('oppRebDefBtn').onclick = ()=> openDefensiveReboundPlayerModal(g);
  document.getElementById('oppRebOffBtn').onclick = ()=>{
    applyOppStat(g, 'oreb');
    saveActiveGame();
    closeModal();
    render();
  };
  document.getElementById('oppRebSkipBtn').onclick = closeModal;
}

function openDefensiveReboundPlayerModal(g){
  const onCourt = roster.players.slice(0,5);
  showModal(`
    <h3>Who grabbed it?</h3>
    <p class="muted" style="margin-bottom:10px;">Defensive rebound — pick from your on-court five, or credit the team.</p>
    <div class="statpad" style="grid-template-columns:repeat(2,1fr);">
      ${onCourt.map(p=>`
        <button class="stat-btn" data-dreb="${p.id}">
          <div class="lbl">#${escapeHtml(p.number)} ${escapeHtml(p.name)}</div>
        </button>`).join('')}
      <button class="stat-btn" data-dreb="${TEAM_PID}">
        <div class="lbl">Team Rebound</div>
      </button>
    </div>
    <button class="btn block" id="oppRebBackBtn" style="margin-top:12px;">Back</button>
  `);
  document.querySelectorAll('[data-dreb]').forEach(btn=> btn.onclick = ()=>{
    const pid = btn.dataset.dreb;
    if(!g.playerStats[pid]){
      if(pid===TEAM_PID){
        g.playerStats[TEAM_PID] = Object.assign(BLANK_LINE(), {name:TEAM_NAME, number:TEAM_NUMBER});
      } else {
        const p = roster.players.find(pp=>pp.id===pid);
        g.playerStats[pid] = Object.assign(BLANK_LINE(), {name:p.name, number:p.number});
      }
    }
    const drebAction = STAT_ACTIONS.find(a=>a.key==='dreb');
    applyStat(g, pid, drebAction);
    saveActiveGame();
    closeModal();
    render();
  });
  document.getElementById('oppRebBackBtn').onclick = ()=> openOppReboundPromptModal(g);
}

// Shared by the live Box Score modal and the History game-detail modal: a
// small tab strip plus the matching body. Callers supply the title/subtitle
// (already escaped) and append their own action buttons after this HTML.
const BOX_SCORE_TABS = [
  { key:'boxscore',    label:'Box Score' },
  { key:'scoring',     label:'Scoring Dev.' },
  { key:'assists',     label:'Assists' },
  { key:'shotchart',   label:'Shot Chart' },
  { key:'possession',  label:'Possession' },
  { key:'lineups',     label:'Lineups' },
];
function boxScoreModalBody(g, teamName, title, subtitle){
  let body;
  if(boxScoreTab==='scoring'){
    body = scoringDevelopmentBlock(g, teamName) || `<p class="muted" style="margin-top:6px;">No scoring plays logged yet.</p>`;
  } else if(boxScoreTab==='assists'){
    body = assistHeatmapBlock(g) || `<p class="muted" style="margin-top:6px;">No assists logged yet.</p>`;
  } else if(boxScoreTab==='shotchart'){
    body = `<div class="card" style="margin-top:0;"><h3 style="font-size:14px;">Shot Chart</h3>${shotChartBlock(g, teamName)}</div>`;
  } else if(boxScoreTab==='possession'){
    body = `<div class="card" style="margin-top:0;"><h3 style="font-size:14px;">Possessions & Ratings</h3>${possessionBlock(g, teamName)}</div>`;
  } else if(boxScoreTab==='lineups'){
    body = lineupBlock(g, teamName);
  } else {
    body = `
      ${Object.keys(g.playerStats).length ? boxScoreTable(g.playerStats, teamName) : '<p class="muted">No stats logged yet.</p>'}
      ${fastBreakLine(g, teamName)}
      ${oppStatsBlock(g)}
    `;
  }
  return `
    <h3>${title}</h3>
    <p class="muted" style="margin-bottom:10px;">${subtitle}</p>
    <div class="subtoggle boxtabs">
      ${BOX_SCORE_TABS.map(t=>`<button data-boxtab="${t.key}" class="${boxScoreTab===t.key?'active':''}">${t.label}</button>`).join('')}
    </div>
    ${body}
  `;
}

// Shared by both box score modals: wires the tab strip and, when the
// Lineups tab is showing, the player-toggle chips (up to 5, redraws in place).
function wireBoxScoreTabs(redraw){
  document.querySelectorAll('[data-boxtab]').forEach(btn=> btn.onclick = ()=>{ boxScoreTab = btn.dataset.boxtab; redraw(); });
  document.querySelectorAll('[data-lineup-pid]').forEach(btn=> btn.onclick = ()=>{
    const pid = btn.dataset.lineupPid;
    const idx = lineupSelection.indexOf(pid);
    if(idx>=0) lineupSelection.splice(idx,1);
    else if(lineupSelection.length<5) lineupSelection.push(pid);
    redraw();
  });
}
function openBoxScoreModal(g, teamName, opponent){
  boxScoreTab = 'boxscore';
  lineupSelection = [];
  const draw = ()=>{
    showModal(`
      ${boxScoreModalBody(g, teamName, 'Box Score', `${escapeHtml(g.quarter||'')} · vs ${escapeHtml(opponent)}`)}
      <div class="row" style="margin-top:14px;">
        <button class="btn" id="exportBox">Export CSV</button>
        <button class="btn primary" id="closeBox">Close</button>
      </div>
    `);
    wireBoxScoreTabs(draw);
    document.getElementById('closeBox').onclick = closeModal;
    document.getElementById('exportBox').onclick = ()=> downloadCSV(csvFilename(g), gameCSVRows(g, teamName));
  };
  draw();
}

/* =========================================================
   ROSTER TAB
========================================================= */
function cloudStatusLabel(){
  if(sb) return 'Connected — your data syncs across every device.';
  if(usingClaudeStorage) return 'Saved via Claude while you use this app here.';
  return 'Saved locally on this device/browser only.';
}
function renderRoster(content){
  content.innerHTML = `
    <div class="card">
      <label class="field">Team name</label>
      <input type="text" id="teamNameInput" value="${escapeHtml(roster.teamName)}" />
    </div>

    <div class="card">
      <h3>Cloud Sync</h3>
      <p class="muted">${cloudStatusLabel()}</p>
      <div class="row" style="margin-top:10px;">
        ${sb
          ? `<button class="btn danger-outline block" id="disconnectSb">Disconnect</button>`
          : `<button class="btn primary block" id="setupSb">Set up Cloud Sync</button>`}
      </div>
    </div>

    <div class="card">
      <h3>Players</h3>
      <div id="playerList">
        ${roster.players.length ? roster.players.map((p,idx)=>`
          <div class="player-row">
            <div class="circle">${escapeHtml(p.number)}</div>
            <div class="pname">${escapeHtml(p.name)}</div>
            <div class="row-actions">
              <button class="btn" data-move="${p.id}:-1" ${idx===0?'disabled':''} style="min-height:36px;padding:6px 8px;">▲</button>
              <button class="btn" data-move="${p.id}:1" ${idx===roster.players.length-1?'disabled':''} style="min-height:36px;padding:6px 8px;">▼</button>
              <button class="rm" data-rm="${p.id}">×</button>
            </div>
          </div>`).join('') : '<p class="muted">No players yet — add your first one below.</p>'}
      </div>
      <div class="row" style="margin-top:12px;">
        <input type="text" id="newName" placeholder="Player name" />
        <input type="number" id="newNumber" placeholder="#" style="max-width:80px;" />
      </div>
      <button class="btn primary block" id="addPlayerBtn" style="margin-top:10px;">Add Player</button>
    </div>
  `;
  const teamInput = content.querySelector('#teamNameInput');
  teamInput.onchange = ()=>{ roster.teamName = teamInput.value.trim() || 'My Team'; saveRoster(); render(); };

  const setupBtn = content.querySelector('#setupSb');
  if(setupBtn) setupBtn.onclick = openSupabaseSetupModal;
  const disconnectBtn = content.querySelector('#disconnectSb');
  if(disconnectBtn) disconnectBtn.onclick = ()=>{
    showModal(`
      <h3>Disconnect Cloud Sync?</h3>
      <p class="muted">Your data stays in the cloud database, but this device will switch back to saving locally only.</p>
      <div class="row">
        <button class="btn" id="cancelDc">Cancel</button>
        <button class="btn danger-outline" id="confirmDc">Disconnect</button>
      </div>
    `);
    document.getElementById('cancelDc').onclick = closeModal;
    document.getElementById('confirmDc').onclick = ()=>{ clearSupabaseConfig(); location.reload(); };
  };

  content.querySelectorAll('[data-rm]').forEach(b=> b.onclick = ()=>{
    roster.players = roster.players.filter(p=>p.id!==b.dataset.rm);
    saveRoster(); render();
  });
  content.querySelectorAll('[data-move]').forEach(btn=> btn.onclick = ()=>{
    const [id, dir] = btn.dataset.move.split(':');
    movePlayerInRoster(id, parseInt(dir,10));
    render();
  });

  content.querySelector('#addPlayerBtn').onclick = ()=>{
    const nameEl = content.querySelector('#newName');
    const numEl = content.querySelector('#newNumber');
    const name = nameEl.value.trim();
    const number = numEl.value.trim();
    if(!name){ toast('Enter a player name'); return; }
    roster.players.push({ id: uid('p'), name, number: number || '0' });
    saveRoster();
    render();
  };
}

function openSupabaseSetupModal(){
  showModal(`
    <h3>Set up Cloud Sync</h3>
    <p class="muted">Paste your Supabase project URL and anon public key — find both under Settings → API in your Supabase project.</p>
    <label class="field">Project URL</label>
    <input type="text" id="sbUrl" placeholder="https://xxxxx.supabase.co" />
    <label class="field">Anon public key</label>
    <input type="text" id="sbKey" placeholder="eyJhbGciOi..." />
    <p class="muted" id="sbError" style="color:var(--miss); min-height:16px; margin-top:8px;"></p>
    <div class="row">
      <button class="btn" id="sbCancel">Cancel</button>
      <button class="btn primary" id="sbSave">Connect</button>
    </div>
  `);
  document.getElementById('sbCancel').onclick = closeModal;
  document.getElementById('sbSave').onclick = async ()=>{
    const url = document.getElementById('sbUrl').value.trim();
    const key = document.getElementById('sbKey').value.trim();
    const errEl = document.getElementById('sbError');
    if(!url || !key){ errEl.textContent = 'Enter both the Project URL and anon key.'; return; }
    if(!window.supabase || !window.supabase.createClient){ errEl.textContent = 'Could not load the Supabase library — check your internet connection.'; return; }
    let testClient;
    try{
      testClient = window.supabase.createClient(url, key);
      const { error } = await testClient.from('courtside_kv').select('key').limit(1);
      if(error) throw error;
    }catch(e){
      errEl.textContent = 'Could not connect — check the URL, the key, and that you ran the setup SQL in Supabase.';
      return;
    }
    // Only seed Supabase from this device's local data the first time (table
    // genuinely empty). If another device already synced data, never
    // overwrite it — just connect and let the reload pull the real data down.
    try{
      const { data: existing } = await testClient.from('courtside_kv').select('key').limit(1);
      if(!existing || existing.length===0){
        const now = new Date().toISOString();
        await testClient.from('courtside_kv').upsert({ key:'roster', value: JSON.stringify(roster), updated_at: now });
        await testClient.from('courtside_kv').upsert({ key:'activeGame', value: JSON.stringify(activeGame), updated_at: now });
        await testClient.from('courtside_kv').upsert({ key:'gameHistory', value: JSON.stringify(history), updated_at: now });
      }
    }catch(e){ /* non-fatal — proceed even if the seed check/copy fails */ }
    setSupabaseConfig({ url, anonKey:key });
    location.reload();
  };
}

/* =========================================================
   HISTORY TAB
========================================================= */
function renderHistory(content){
  if(history.length===0){
    content.innerHTML = `<div class="empty"><div class="big">📋</div><h2>No games yet</h2><p class="muted">Finished games will show up here with their full box score.</p></div>`;
    return;
  }
  content.innerHTML = `
    <button class="btn block" id="exportSeason" style="margin-bottom:12px;">Export Season CSV</button>
    ${history.map((g,idx)=>`
    <div class="game-row" data-idx="${idx}">
      <div class="top-line">
        <span><b>${escapeHtml(g.finalTeam)}</b> — ${escapeHtml(g.finalOpp)} vs ${escapeHtml(g.opponent)}</span>
        <span class="badge ${g.result==='W'?'win':(g.result==='L'?'loss':'')}">${g.result==='T'?'TIE':g.result}</span>
      </div>
      <div class="date">${new Date(g.date).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'})}</div>
    </div>
  `).join('')}`;
  content.querySelector('#exportSeason').onclick = ()=> downloadCSV('season_stats.csv', seasonCSVRows());
  content.querySelectorAll('.game-row').forEach(el=> el.onclick = ()=>{
    const g = history[parseInt(el.dataset.idx,10)];
    boxScoreTab = 'boxscore';
    lineupSelection = [];
    const drawHist = ()=>{
      showModal(`
        ${boxScoreModalBody(g, g.teamName, `vs ${escapeHtml(g.opponent)}`, `${new Date(g.date).toLocaleDateString(undefined,{month:'long',day:'numeric',year:'numeric'})} · Final: ${g.finalTeam}-${g.finalOpp}`)}
        <div class="row" style="margin-top:14px;">
          <button class="btn danger-outline" id="deleteGame">Delete</button>
          <button class="btn" id="exportGame">Export CSV</button>
        </div>
        <button class="btn primary block" id="closeHist" style="margin-top:10px;">Close</button>
      `);
      wireBoxScoreTabs(drawHist);
      document.getElementById('closeHist').onclick = closeModal;
      document.getElementById('exportGame').onclick = ()=> downloadCSV(csvFilename(g), gameCSVRows(g, g.teamName));
      document.getElementById('deleteGame').onclick = ()=>{
        history = history.filter(x=>x.id!==g.id);
        saveHistory();
        closeModal();
        render();
      };
    };
    drawHist();
  });
}

/* =========================================================
   MODAL + UTIL
========================================================= */
function showModal(innerHtml){
  const root = document.getElementById('modalRoot');
  root.innerHTML = `<div class="modal-back" id="modalBack"><div class="modal">${innerHtml}</div></div>`;
  document.getElementById('modalBack').addEventListener('click', e=>{ if(e.target.id==='modalBack') closeModal(); });
}
function closeModal(){ document.getElementById('modalRoot').innerHTML = ''; }
function escapeHtml(str){
  return String(str==null?'':str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

