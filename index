// The reorder rail's top 5 players double as the on-court five (see the
// "Reorder Players" hint in Live). We snapshot that five onto every log
// entry as it's created, so lineup analysis can later filter the log by
// exactly which five were on the floor for each play.
function currentOnCourt(){ return roster.players.slice(0,5).map(p=>p.id); }
function applyStat(g, pid, action){
  const line = g.playerStats[pid];
  Object.entries(action.inc).forEach(([k,v])=>{ line[k] = (line[k]||0) + v; });
  let fbPts = 0, fbMiss = false;
  if(fbArmed.us){
    if(action.inc.pts){
      ensureFastBreak(g);
      fbPts = action.inc.pts;
      g.fastBreak.us += fbPts;
      fbArmed.us = false;
    } else if(FASTBREAK_MISS_KEYS_US.includes(action.key)){
      ensureFastBreak(g);
      g.fastBreak.usMiss += 1;
      fbMiss = true;
      fbArmed.us = false;
    }
  }
  // A steal by our team is automatically the other team's turnover — no need
  // to tap it twice. The reverse never auto-fires: our own turnover still
  // requires picking the player who committed it, on purpose.
  let autoOppTov = false;
  if(action.key === 'stl'){
    ensureOppStats(g);
    g.oppStats.tov = (g.oppStats.tov||0) + 1;
    autoOppTov = true;
  }
  g.log.push({type:'stat', pid, key:action.key, inc:action.inc, fbPts, fbMiss, fbSide: (fbPts||fbMiss)?'us':null, fastBreak: !!fbPts, quarter: g.quarter, autoOppTov, onCourt: currentOnCourt()});
}
function undoLast(g){
  const last = g.log.pop();
  if(!last) return;
  if(last.type==='opp'){ g.oppScore -= last.delta; }
  else if(last.type==='stat'){
    const line = g.playerStats[last.pid];
    Object.entries(last.inc).forEach(([k,v])=>{ line[k] -= v; });
    if(last.fbPts){ ensureFastBreak(g); g.fastBreak[last.fbSide] -= last.fbPts; }
    if(last.fbMiss){ ensureFastBreak(g); g.fastBreak[last.fbSide+'Miss'] -= 1; }
    if(last.autoOppTov){ ensureOppStats(g); g.oppStats.tov -= 1; }
  }
  else if(last.type==='oppstat'){
    ensureOppStats(g);
    g.oppStats[last.key] -= 1;
    if(last.pts) g.oppScore -= last.pts;
    if(last.fbPts){ ensureFastBreak(g); g.fastBreak[last.fbSide] -= last.fbPts; }
    if(last.fbMiss){ ensureFastBreak(g); g.fastBreak[last.fbSide+'Miss'] -= 1; }
  }
}
function applyOppStat(g, key){
  ensureOppStats(g);
  g.oppStats[key] = (g.oppStats[key]||0) + 1;
  const action = OPP_STAT_ACTIONS.find(a=>a.key===key);
  const pts = (action && action.pts) ? action.pts : 0;
  if(pts) g.oppScore += pts;
  let fbPts = 0, fbMiss = false;
  if(fbArmed.opp){
    if(pts){
      ensureFastBreak(g);
      fbPts = pts;
      g.fastBreak.opp += fbPts;
      fbArmed.opp = false;
    } else if(FASTBREAK_MISS_KEYS_OPP.includes(key)){
      ensureFastBreak(g);
      g.fastBreak.oppMiss += 1;
      fbMiss = true;
      fbArmed.opp = false;
    }
  }
  g.log.push({type:'oppstat', key, pts, fbPts, fbMiss, fbSide: (fbPts||fbMiss)?'opp':null, quarter: g.quarter, onCourt: currentOnCourt()});
}
function totalPts(playerStats){ return Object.values(playerStats).reduce((s,l)=>s+l.pts,0); }
function nameOf(pid){ if(pid===TEAM_PID) return TEAM_NAME; const p = roster.players.find(p=>p.id===pid); return p?p.name:'Player'; }
function numberOf(pid){ if(pid===TEAM_PID) return TEAM_NUMBER; const p = roster.players.find(p=>p.id===pid); return p?p.number:''; }

